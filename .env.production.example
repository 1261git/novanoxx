PUBLIC_BASE_URL=https://YOUR_PUBLIC_DOMAIN
PORT=4317
HOST=0.0.0.0
DATA_DIR=/data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Operating ordinary payments: contract approval, matched live keys and reconciliation.
# Existing TOSS_* variables above do not activate the operating payment engine.
NNX_PAYMENT_CONTRACT_APPROVED=0
NNX_OPERATING_RECONCILIATION_APPROVED=0
NNX_LIVE_PAYMENTS=0
NNX_LIVE_REFUNDS=0
NNX_TOSS_LIVE_CLIENT_KEY=
NNX_TOSS_LIVE_SECRET_KEY=

# Recurring billing uses its own contracted MID and encrypted billing-key store.
NNX_BILLING_CONTRACT_APPROVED=0
NNX_TOSS_BILLING_LIVE_CLIENT_KEY=
NNX_TOSS_BILLING_LIVE_SECRET_KEY=
NNX_BILLING_ENCRYPTION_KEY=
NNX_BILLING_ENCRYPTION_KEY_ID=

# Mail is already active on the operating service. These are installation examples.
# After activation, pause sending instead of disabling verification or replacing its key.
NNX_MAIL_ENABLED=0
NNX_MAIL_SEND_PAUSED=1
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NNX_MAIL_ENCRYPTION_KEY=
NNX_MAIL_FROM=NovaNoxX <no-reply@notify.novanoxx.com>
NNX_MAIL_REPLY_TO=support@novanoxx.com

# Payout v2: separate contract and keys. Keep transfers off until owner review.
NNX_SETTLEMENT_CONTRACT_APPROVED=0
NNX_PAYOUTS_CONTRACT_APPROVED=0
NNX_TOSS_PAYOUT_SECRET_KEY=
NNX_TOSS_PAYOUT_SECURITY_KEY=
# Independent 32-byte base64 data key; preserve its recovery copy before enabling.
NNX_PAYOUT_DATA_ENCRYPTION_KEY=
NNX_PAYOUT_DATA_KEY_ID=
NNX_PAYOUT_KEY_RECOVERY_CONFIRMED=0
NNX_LIVE_PAYOUTS=0

# Separately approved subscription refunds, requires billing and general refund gates.
NNX_LIVE_SUBSCRIPTION_REFUNDS=0
