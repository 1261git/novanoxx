FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --prod --frozen-lockfile
COPY --chown=node:node . .
USER node
ENV NODE_ENV=production PORT=10000 SANDBOX_RUNTIME_DIR=/tmp/nnx-sandbox-runtime
EXPOSE 10000
CMD ["node", "sandbox-cloud.cjs"]
