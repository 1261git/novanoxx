    "accountLinked": true,
    "ipCollected": false,
    "retentionDays": 120,
    "defaultAllowed": false,
    "eraseOnWithdrawal": true
  },
  "futureDiscoveryBackups": {
    "includeRawRecords": true,
    "retentionFromCreationDays": 90,
    "recommendedDays": 7,
    "status": "OWNER_CONFIRMED_90_DAYS_NOT_OPERATING_ENABLED",
    "existingOperatingTestAndTradeBackupsPreserved": true,
    "accessAfterWithdrawal": "BLOCK_UNTIL_VERIFIED_DELETION_FILTER",
    "restoreBeforeService": "REAPPLY_EXPIRY_AND_CURRENT_DELETIONS_WITH_COLLECTION_DISABLED",
    "destructiveCleanupEnabled": false,
    "restorePreparation": {
      "module": "discovery-restore-filter.cjs",
      "mode": "ISOLATED_RESTORE_ONLY",
      "currentStateSource": "TRUSTED_LATEST_PREFERENCES_AND_DELETION_CUTOFFS_REQUIRED",
      "unknownActors": "REMOVE_DISCOVERY_RECORDS",
      "collectionAfterRestore": false,
      "productionPipelineConnected": false,
      "localSqliteCoordinator": "discovery-isolated-restore.cjs"
    },
    "ownerConfirmedDays": 90
  },
